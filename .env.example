# Active environment (used if TEST_ENV is not passed at runtime)
ENVIRONMENT=dev

# UI configuration
UI_BASE_URL=https://www.service.nsw.gov.au
UI_SEARCH_PATH=/search-results

# API configuration
# Get your API key from NSW Government API Portal: https://api.nsw.gov.au/
API_BASE_URL=https://api.nsw.gov.au
API_KEY=your-api-key-here
API_SECRET=your-api-secret-here
API_AUTH_HEADER=
API_PRODUCT_CATEGORY_PATH=/ProductCategory

# Fuel API (OneGov)
FUEL_API_BASE_URL=https://api.onegov.nsw.gov.au
FUEL_API_OAUTH_PATH=/oauth/client_credential/accesstoken?grant_type=client_credentials
FUEL_API_LOVS_PATH=/FuelCheckRefData/v1/fuel/lovs
FUEL_API_KEY=
FUEL_API_SECRET=
FUEL_API_AUTH_HEADER=

# Optional test runner flags
DEBUG=false
TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=5000
